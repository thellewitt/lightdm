# Autotools / Libtool generated files
*.la
*.lo
*.o
*.pc
/Makefile
/Makefile.in
/aclocal.m4
/config.h
/config.h.in
/config.log
/config.status
/configure
/configure~
/libtool
/stamp-h1
/autom4te.cache/

# Generated Makefiles and dependency/build directories
/*/Makefile
/*/Makefile.in
/*/.deps/
/*/.libs/
/tests/src/Makefile
/tests/src/Makefile.in
/tests/src/.deps/
/tests/src/.libs/

# Generated translations / intltool
/po/*.gmo
/po/lightdm.pot
/po/Makefile.in
/po/POTFILES
/po/stamp-it
/po/.intltool-merge-cache
/po/.intltool-merge-cache.lock

# Generated introspection / Vala
/liblightdm-gobject/*.gir
/liblightdm-gobject/*.typelib
/liblightdm-gobject/*.vapi

# Generated Qt MOC sources
/liblightdm-qt/*_moc5.cpp
/liblightdm-qt/*_moc6.cpp
/tests/src/*_moc5.cpp
/tests/src/*_moc6.cpp

# Generated data
/data/lightdm-guest-session
/data/org.freedesktop.DisplayManager.AccountsService.policy

